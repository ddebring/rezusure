# ---------------------------------------------
# App
# ---------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=REZUSURE

# ---------------------------------------------
# Firebase Web SDK (client-safe values)
# ---------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------
# Firebase Admin SDK (server-only)
# Use a service-account JSON as a single env var or your hosting provider's
# secret manager. Never expose these as NEXT_PUBLIC_* variables.
# ---------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# ---------------------------------------------
# AI (server-only)
# ---------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=

# ---------------------------------------------
# Country / geolocation (server-only)
# COUNTRY_DETECTION_MODE=header|provider|development
# In production, use a trusted platform/provider IP-country signal.
# ---------------------------------------------
COUNTRY_DETECTION_MODE=development
COUNTRY_GEOIP_URL=https://your-provider.example/{ip}
COUNTRY_GEOIP_API_KEY=
DEV_COUNTRY=IN

# ---------------------------------------------
# Billing - India
# ---------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------
# Billing - International (Paddle)
# ---------------------------------------------
PADDLE_CLIENT_SIDE_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox

# ---------------------------------------------
# Observability (optional foundation hooks)
# ---------------------------------------------
LOG_LEVEL=info
