rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function profileUpdateAllowed(userId) {
      return isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'provider', 'createdAt', 'updatedAt'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['freeAnalysesRemaining', 'paidCredits', 'totalAnalysesUsed', 'createdAt']);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'provider', 'createdAt', 'updatedAt']);
      allow update: if profileUpdateAllowed(userId);
      allow delete: if false;

      match /resumes/{resumeId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId);

        match /analyses/{analysisId} {
          allow read, create, update: if isOwner(userId);
          allow delete: if isOwner(userId);
        }
      }

      match /purchases/{purchaseId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /credit-ledger/{ledgerEntryId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    match /resumes/{resumeId} {
      allow read, write: if false;
    }

    match /analyses/{analysisId} {
      allow read, write: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read, write: if false;
    }

    match /usage/{usageId} {
      allow read, write: if false;
    }

    match /payments/{paymentId} {
      allow read, write: if false;
    }

    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
